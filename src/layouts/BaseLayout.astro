---
// Basic layout with header and footer
const { title } = Astro.props;
---
<!doctype html>
<html lang="ja">
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width,initial-scale=1" />
    <title>{title ? title + ' - takexaz' : 'takexaz'}</title>
  </head>
  <body>
    <header>
      <nav>
        <a href="/">Home</a> |
        <a href="/about">About</a> |
        <a href="/portfolio">Portfolio</a> |
        <a href="/blog">Blog</a>
      </nav>
    </header>

    <main>
      <slot />
    </main>

    <footer>
      <p>© {new Date().getFullYear()} takexaz</p>
    </footer>
  </body>
</html>
